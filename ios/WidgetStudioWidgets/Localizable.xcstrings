      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم في التشغيل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control playback"
          }
        }
