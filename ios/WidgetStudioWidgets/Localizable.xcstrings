    "widget.intent.stopwatch.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل أو إيقاف ساعة الإيقاف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or stop the stopwatch"
          }
        }
      }
    },
    "widget.intent.timer.add": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة وقت للمؤقت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add time to the timer"
          }
        }
      }
    },
    "widget.intent.timer.minutes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدقائق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        }
      }
    },
    "widget.intent.timer.reset": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفير المؤقت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the timer"
          }
        }
      }
    },
    "widget.intent.timer.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل أو إيقاف المؤقت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or pause the timer"
          }
        }
      }
    },
    "widget.mywidget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أحدث تصميم حفظته في «ودجاتي» بهذا المقاس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your newest saved design that fits this size."
          }
        }
      }
    },
    "widget.mywidget.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تصميمًا بهذا المقاس في التطبيق ليظهر هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a design of this size in the app to show it here."
          }
        }
      }
    },
    "widget.mywidget.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ويدجتي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My widget"
          }
        }
      }
    },
    "widget.mywidget.noAppGroup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصاميم المحفوظة تظهر هنا في نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved designs appear here in the App Store version."
          }
        }
      }
    },
