{
  "sourceLanguage": "ar",
  "strings": {
    "widget.gap.noTasks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق واسمح بالوصول إلى التذكيرات لعرض مهامك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app and allow Reminders to show your tasks"
          }
        }
      }
    },
    "widget.intent.task.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنجاز مهمة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a task"
          }
        }
      }
    },
    "widget.intent.task.id": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المهمة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task"
          }
        }
      }
    },
    "widget.mywidget.deleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذف التصميم، اختر غيره"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design deleted, choose another"
          }
        }
      }
    },
    "widget.gap.noBattery": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى البطارية غير متاح للويدجت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery level isn't available to the widget."
          }
        }
      }
    },
    "widget.gap.noHealth": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الويدجت قراءة الخطوات والنوم في هذه النسخة. اسمح بـ«صحتي» من إعدادات التطبيق؛ وإن بقيت الرسالة فالأمر يحتاج نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget can't read steps and sleep on this install. Allow Health in the app's Settings; if this stays, it needs the App Store version."
          }
        }
      }
    },
    "widget.gap.noLocation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ستوديو الويدجت واسمح بالموقع «أثناء استخدام التطبيق»، وسيحدّد الويدجت مكانك بنفسه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Widget Studio and allow location “While Using the App”; the widget then finds your place itself."
          }
        }
      }
    },
    "widget.gap.noWeather": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد طقس بعد. يجلبه الويدجت تلقائيًا عند الاتصال بالإنترنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weather yet. The widget fetches it by itself when you're online."
          }
        }
      }
    },
    "widget.intent.counter.increment": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسبيحة +١"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count +1"
          }
        }
      }
    },
    "widget.intent.counter.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكر التالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next dhikr"
          }
        }
      }
    },
