{
  "sourceLanguage": "ar",
  "strings": {
    "widget.switcher.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل التصاميم على الويدجت نفسها بـ ◀ ▶. القفل 🔒 يخفي الأسهم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch designs right on the widget with ◀ ▶. 🔒 hides the arrows."
          }
        }
      }
    },
    "widget.switcher.intent.lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل الأسهم أو فتحها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock or unlock the arrows"
          }
        }
      }
    },
    "widget.switcher.intent.offset": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطوة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step"
          }
        }
      }
    },
    "widget.switcher.intent.size": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "widget.switcher.intent.step": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبديل التصميم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch design"
          }
        }
      }
    },
    "widget.switcher.lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء الأسهم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the arrows"
          }
        }
      }
    },
    "widget.switcher.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصميم التالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next design"
          }
        }
      }
    },
    "widget.switcher.pair.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في ستوديو الويدجت P: الإعدادات ← ربط الويدجت، ثم اكتب هذا الرمز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Widget Studio P: Settings → Pair widget, then type this code."
          }
        }
      }
    },
    "widget.switcher.pair.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط هذه الويدجت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this widget"
          }
        }
      }
    },
    "widget.switcher.previous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصميم السابق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous design"
          }
        }
      }
    },
    "widget.switcher.unlock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الأسهم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the arrows"
          }
        }
      }
    }
  },
  "version": "1.0"
