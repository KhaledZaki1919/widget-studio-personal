{
  "sourceLanguage": "ar",
  "strings": {
    "widget.slot.code.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في التطبيق: افتح تصميمًا ← أرسل إلى ويدجت، واكتب هذا الرمز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app: open a design → Send to widget, and type this code."
          }
        }
      }
    },
    "widget.slot.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض رمزها الخاص حتى ترسل إليه تصميمًا من التطبيق. لكل خانة ولكل حجم رمز مختلف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows its own code until you send a design to it from the app. Each slot and size has its own code."
          }
        }
      }
    },
    "widget.slot.name %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خانة %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot %@"
          }
        }
      }
    },
    "widget.slot.pick.a": {
