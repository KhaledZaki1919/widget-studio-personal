    "widget.slot.pick.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربة: اختر الخانة من «تعديل الويدجت». إن بقيت رمادية فاستخدم الخانات 1–5."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test: pick the slot in Edit Widget. If it stays gray, use Slots 1–5."
          }
        }
      }
    },
    "widget.slot.pick.e": {
