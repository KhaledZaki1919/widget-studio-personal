    "send.sent.body %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعرضه الويدجت ذات الرمز %1$@ (الخانة %2$@) خلال ثوانٍ. لتغييره أرسل تصميمًا آخر إلى الرمز نفسه في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget with code %1$@ (slot %2$@) shows it within seconds. To change it, send another design to the same code at any time."
          }
        }
      }
    },
