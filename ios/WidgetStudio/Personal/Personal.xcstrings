            "value": "Your widgets"
          }
        }
      }
    },
    "send.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد خادم وسيط في هذا الإصدار، فلا يمكن إرسال التصاميم إلى الويدجت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No relay is set in this build, so designs can't reach the widgets."
