    "home.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خانة من ستوديو الويدجت P إلى شاشتك الرئيسية، ثم أرسل تصميمًا إلى الرمز الذي تعرضه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Widget Studio P slot to your home screen, then send a design to the code it shows."
          }
        }
      }
    },
    "home.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ويدجتات بعد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No widgets yet"
          }
        }
      }
    },
    "home.howto": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف تعمل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        }
      }
    },
    "home.howto.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية ← تعديل ← إضافة ويدجت ← ستوديو الويدجت P ← «خانة 1» بأي حجم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the home screen → Edit → Add Widget → Widget Studio P → \"Slot 1\" in any size."
          }
        }
      }
    },
    "home.howto.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الويدجت رمزها الخاص مثل ABC-DEF. لكل خانة ولكل حجم رمز مختلف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget shows its own code, like ABC-DEF. Each slot and size has its own code."
          }
        }
      }
    },
    "home.howto.3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي تصميم ← أرسل إلى ويدجت ← اكتب الرمز ← أرسل. تعرضه الويدجت خلال ثوانٍ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open any design → Send to widget → type the code → Send. The widget shows it within seconds."
          }
        }
      }
    },
    "home.howto.4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتغييره أرسل تصميمًا آخر إلى الرمز نفسه. «إزالة» تحرّر الرمز فتعود الويدجت لعرضه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change it, send another design to the same code. Remove frees the code: the widget shows it again."
          }
        }
      }
    },
    "home.missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير موجود على الخادم الوسيط؛ أرسل التصميم مجددًا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on the relay; send the design again"
          }
        }
      }
    },
