    "send.code.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحرف الستة التي تظهر على الويدجت في الشاشة الرئيسية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 6 characters the widget shows on your home screen."
          }
        }
      }
    },
    "send.error.fit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التصميم أكبر من تلك الويدجت. اختر ويدجت أكبر أو تصميمًا أصغر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This design is bigger than that widget. Pick a larger widget or a smaller design."
          }
        }
      }
    },
    "send.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز ٦ أحرف وأرقام، مثل ABC-DEF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code has 6 letters and digits, like ABC-DEF."
          }
        }
      }
    },
    "send.error.network %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الإرسال (%@). تحقّق من الاتصال وحاول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send (%@). Check the connection and try again."
          }
        }
      }
    },
    "send.error.rate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسالات كثيرة في دقيقة. حاول بعد قليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sends in a minute. Try again shortly."
          }
        }
      }
    },
    "send.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصميم وصورته أكبر من أن يُرسلا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design and its photo are too large to send."
          }
        }
      }
    },
    "send.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ويدجت تعرض هذا الرمز. تحقّق من الرمز على الشاشة الرئيسية؛ الويدجت المضافة للتو تحتاج بضع ثوانٍ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No widget shows this code. Check the code on your home screen; a widget you just added needs a few seconds."
          }
        }
      }
    },
    "send.known": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
